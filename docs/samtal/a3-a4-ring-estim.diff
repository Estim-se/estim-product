+export type RingSectionView = { drafts: RingDraftView[]; companies: { id: string; name: string }[]; pending: { id: string; started_at: string; companies: { id: string; name: string }[] }[] };
+
+const when = (iso: string | null) => iso ? new Date(iso).toLocaleString('sv-SE', { timeZone: 'Europe/Stockholm', dateStyle: 'short', timeStyle: 'short' }) : '';
