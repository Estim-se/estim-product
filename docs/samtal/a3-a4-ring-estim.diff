diff -ruN ra/src/lib/samtal/ring/page.server.ts rb/src/lib/samtal/ring/page.server.ts
--- ra/src/lib/samtal/ring/page.server.ts	1970-01-01 00:00:00.000000000 +0000
+++ rb/src/lib/samtal/ring/page.server.ts	2026-11-26 14:15:43.394349364 +0000
@@ -0,0 +1,45 @@
+// estim Samtal A3/A4 (Ring estim): the server side of the voice-note section of the Samtal page.
+//   - drafts are read through the signed-in user's own client, so RLS decides visibility (owners: company; employees:
+//     their own notes);
+//   - the employee's own pending notes and enrolled companies are read with the service client, bounded to the
+//     verified actor id from the auth middleware (never a browser value), and expose ids, times and company names only;
+//   - choosing a company (before calling, or afterwards for a pending note) goes through service-only functions that
+//     repeat the enrollment, membership and activity checks.
+import type { SupabaseClient } from '@supabase/supabase-js';
+import type { Database } from '@/integrations/supabase/types';
+import { SamtalPageError } from '../page.server';
+
+type Db = SupabaseClient<Database>;
+
+export async function loadRingSection(user: Db, admin: Db, actorId: string) {
+  const [drafts, pending, enrolled] = await Promise.all([
+    user.from('samtal_ring_drafts').select('id, call_id, user_id, kind, title, body, due_at, customer_id, state, needs_review, created_at').order('created_at', { ascending: false }).limit(200),
+    admin.rpc('samtal_ring_pending_for', { p_actor: actorId }),
+    admin.from('samtal_ring_identities').select('company_id').eq('user_id', actorId).is('revoked_at', null),
+  ]);
+  if (drafts.error || pending.error || enrolled.error) throw new SamtalPageError('Röstanteckningar kunde inte läsas.');
+  const ids = [...new Set([...(enrolled.data ?? []).map(e => e.company_id), ...(pending.data ?? []).flatMap(p => p.companies ?? [])])];
+  const companies = ids.length ? await admin.from('companies').select('id, name').in('id', ids).eq('active', true) : { data: [], error: null };
+  if (companies.error) throw new SamtalPageError('Röstanteckningar kunde inte läsas.');
+  const names = new Map((companies.data ?? []).map(c => [c.id, c.name]));
+  const own = [...new Set((enrolled.data ?? []).map(e => e.company_id))].filter(id => names.has(id));
+  return {
+    drafts: drafts.data ?? [],
+    // Only offered when the employee belongs to several companies; one company is attributed automatically.
+    companies: own.length > 1 ? own.map(id => ({ id, name: names.get(id)! })) : [],
+    pending: (pending.data ?? []).map(p => ({ id: p.id, started_at: p.started_at, companies: (p.companies ?? []).filter(id => names.has(id)).map(id => ({ id, name: names.get(id)! })) })),
+  };
+}
+
+export async function setRingContext(admin: Db, actorId: string, companyId: string) {
+  const r = await admin.rpc('samtal_ring_set_context', { p_actor: actorId, p_company: companyId });
+  if (r.error || r.data !== true) throw new SamtalPageError('Företaget kunde inte väljas.');
+  return { chosen: true };
+}
+
+export async function assignRingNote(admin: Db, actorId: string, pendingId: string, companyId: string) {
+  const r = await admin.rpc('samtal_ring_assign', { p_actor: actorId, p_pending: pendingId, p_company: companyId });
+  const status = (r.data as { status?: string } | null)?.status;
+  if (r.error || status !== 'assigned') throw new SamtalPageError('Anteckningen kunde inte kopplas till företaget.');
+  return { assigned: true };
+}
diff -ruN ra/src/lib/samtal/ring/process.server.ts rb/src/lib/samtal/ring/process.server.ts
--- ra/src/lib/samtal/ring/process.server.ts	1970-01-01 00:00:00.000000000 +0000
+++ rb/src/lib/samtal/ring/process.server.ts	2026-11-26 14:15:43.394349364 +0000
@@ -0,0 +1,96 @@
+// estim Samtal A3/A4 (Ring estim): processing of one voice-note job, on the same claimed, lease-fenced job as a
+// telephone call (process.server.ts hands over when samtal_calls.kind = 'rostanteckning'). Same guarantees:
+//   - every write goes through a fenced function (samtal_write_stage, samtal_commit_private, samtal_ring_commit,
+//     samtal_retry_guarded, samtal_release_job); a lost lease or a deleted/private call stops without writing;
+//   - privat: deletion starts at once; osaker: held for review by an authorized person; jobb (including mixed notes
+//     with their private passages removed): internal drafts only, nothing is sent, ordered or priced.
+// Every read is bound to the job's company. Logging: codes only.
+import type { SupabaseClient } from '@supabase/supabase-js';
+import type { Database, Json } from '@/integrations/supabase/types';
+import { SAMTAL_AUDIO_TYPES } from '../call';
+import type { CustomerCandidate } from '../customer-match';
+import type { SpeechToText } from '../stt.server';
+import type { Transcript } from '../transcript';
+import type { RingAi } from './ai.server';
+import { stockholmDate } from './deadline';
+import { buildRingDrafts, matchRingCustomer, redactTranscript } from './drafts';
+import { validateVoiceNote, type VoiceNote } from './voice-note';
+
+type Db = SupabaseClient<Database>;
+type Job = Database['public']['Functions']['samtal_claim_jobs']['Returns'][number];
+export type RingCall = { id: string; company_id: string; audio_path: string | null; transcript: Json | null; extraction: Json | null; started_at: string };
+export type RingDeps = { stt: SpeechToText; ringAi: RingAi };
+
+const MAX_ATTEMPTS = 5;
+class StepError extends Error { constructor(code: string, readonly retryable = false) { super(code); } }
+const codeOf = (e: unknown) => e instanceof Error && /^[a-z0-9_]{1,60}$/.test(e.message) ? e.message : 'processing_error';
+const retryable = (e: unknown) => !!(e && typeof e === 'object' && 'retryable' in e && (e as { retryable: unknown }).retryable === true);
+const backoff = (attempts: number) => Math.min(3600, 60 * 2 ** Math.max(0, attempts - 1));
+
+export async function processRingJob(db: Db, deps: RingDeps, job: Job, call: RingCall): Promise<string> {
+  const company = job.company_id, token = job.lease_token;
+  if (!token) return 'stopped';
+  const lease = { p_call: call.id, p_company: company, p_job: job.id, p_token: token };
+  const live = async () => { const r = await db.rpc('samtal_safety_live', lease); return !r.error && r.data === true; };
+  let step = job.step, privateIntent = false;
+  try {
+    let transcript = call.transcript as Transcript | null;
+    const saved = (call.extraction as { voice_note?: VoiceNote } | null)?.voice_note ?? null;
+    if (!transcript && step !== 'inkorg') {
+      step = 'transkribera';
+      const path = call.audio_path;
+      if (!path || !path.startsWith(`${company}/`)) throw new StepError('audio_missing');
+      const file = await db.storage.from('samtal-audio').download(path);
+      if (file.error || !file.data) throw new StepError('audio_download_failed', true);
+      if (!await live()) return 'stopped';
+      const extension = path.split('.').pop() ?? '';
+      transcript = await deps.stt.transcribe({ bytes: new Uint8Array(await file.data.arrayBuffer()), contentType: SAMTAL_AUDIO_TYPES[extension] ?? 'application/octet-stream', extension });
+      const w = await db.rpc('samtal_write_stage', { ...lease, p_stage: 'transkribera', p_value: transcript as unknown as Json });
+      if (w.error) throw new StepError('transcript_not_saved', true);
+      if (w.data !== true) return 'stopped';
+    }
+    let note: VoiceNote;
+    if (step === 'inkorg' && saved) {
+      // Confirmed as business after review: continue from the saved result, without speech to text or AI.
+      note = { ...saved, classification: 'jobb' };
+    } else {
+      step = 'tolka';
+      if (!transcript) throw new StepError('transcript_missing');
+      if (!await live()) return 'stopped';
+      note = validateVoiceNote(await deps.ringAi.interpretVoiceNote(transcript, { today: stockholmDate(call.started_at) }), transcript, call.started_at);
+      if (note.classification === 'privat') {
+        privateIntent = true;
+        const r = await db.rpc('samtal_commit_private', lease);
+        if (r.error) throw new StepError('private_cleanup_not_saved', true);
+        return r.data === true ? 'privat' : 'stopped';
+      }
+      if (note.classification === 'osaker') {
+        // Held for review: the database pauses the job before the classification is visible.
+        const r = await db.rpc('samtal_write_stage', { ...lease, p_stage: 'tolka', p_value: { interpretation: { classification: 'osaker' }, voice_note: note } as unknown as Json });
+        if (r.error) throw new StepError('extraction_not_saved', true);
+        return r.data === true ? 'osaker' : 'stopped';
+      }
+    }
+    const candidates = await db.from('customers').select('id, name, phone, address, place').eq('company_id', company).order('created_at', { ascending: false }).limit(5000);
+    if (candidates.error) throw new StepError('customers_read_failed', true);
+    const match = matchRingCustomer(note, candidates.data as CustomerCandidate[]);
+    const drafts = buildRingDrafts(note);
+    const redacted = note.mixed && transcript ? redactTranscript(transcript, note.private_spans) : null;
+    // The stored result keeps no private passage positions beyond what is needed, and no private text.
+    const stored = { interpretation: { classification: 'jobb' }, voice_note: { ...note, private_spans: [] }, customer_match: match };
+    const r = await db.rpc('samtal_ring_commit', { ...lease, p_extraction: stored as unknown as Json, p_transcript: redacted as unknown as Json, p_drafts: drafts as unknown as Json,
+      p_customer: match.kind === 'befintlig' ? match.customer_id : (null as unknown as string) });
+    if (r.error) throw new StepError('ring_not_saved', true);
+    return r.data === true ? 'done' : 'stopped';
+  } catch (error) {
+    const code = codeOf(error);
+    const missingKey = code === 'stt_not_configured' || code === 'stt_unsupported_provider' || code === 'ai_not_configured';
+    const again = missingKey || privateIntent || code === 'ai_invalid_output' && job.attempts < 2 || retryable(error) && job.attempts < MAX_ATTEMPTS;
+    if (again) {
+      const r = await db.rpc('samtal_retry_guarded', { ...lease, p_error: code, p_retry_seconds: missingKey ? 3600 : backoff(job.attempts) });
+      return !r.error && r.data === true ? 'retry' : 'stopped';
+    }
+    const r = await db.rpc('samtal_release_job', { p_job: job.id, p_token: token, p_state: 'failed', p_step: step, p_error: code, p_retry_seconds: 0 });
+    return !r.error && r.data === true ? code : 'stopped';
+  }
+}
diff -ruN ra/src/lib/samtal/ring/voice-note.ts rb/src/lib/samtal/ring/voice-note.ts
--- ra/src/lib/samtal/ring/voice-note.ts	1970-01-01 00:00:00.000000000 +0000
+++ rb/src/lib/samtal/ring/voice-note.ts	2026-11-26 14:15:43.394349364 +0000
@@ -0,0 +1,172 @@
+// estim Samtal A3/A4 (Ring estim): the structured result of one voice note, validated in code against the transcript.
+// The transcript is untrusted data. Every item must cite a time span in the note; names, quantities and the words of
+// work and material items must appear in the cited passage, so nothing invented survives validation. Deadlines are
+// resolved in code (deadline.ts). Uncertainty notes never repeat a rejected value, so invented content is not kept. Passages the AI marks private (mixed notes) are dropped from every item.
+// Browser-safe and pure.
+import { z } from 'zod';
+import type { Transcript } from '../transcript';
+import { resolveSwedishDeadline } from './deadline';
+
+const span = z.object({ start: z.number().min(0), end: z.number().min(0) }).nullable();
+const text = z.string().trim().min(1).max(300);
+const phrase = z.string().trim().max(120).nullable();
+const field = z.object({ value: z.string().trim().max(200).nullable(), source: span });
+const rawSchema = z.object({
+  classification: z.enum(['jobb', 'privat', 'osaker']),
+  private_spans: z.array(z.object({ start: z.number().min(0), end: z.number().min(0) })).max(50).default([]),
+  customer: z.object({ name: field, address: field, place: field }),
+  project: field,
+  work: z.array(z.object({ text, source: span })).max(20),
+  agreements: z.array(z.object({ text, source: span })).max(10),
+  measurements: z.array(z.object({ text, quantity: z.number().min(0).max(100000).nullable(), unit: z.string().max(20).nullable(), source: span })).max(20),
+  materials: z.array(z.object({ item: text, quantity: z.number().min(0).max(100000).nullable(), unit: z.string().max(20).nullable(), source: span })).max(30),
+  tasks: z.array(z.object({ title: text, deadline: phrase, source: span })).max(10),
+  reminders: z.array(z.object({ title: text, when: phrase, source: span })).max(10),
+  quote: z.object({ needed: z.boolean(), deadline: phrase, source: span }),
+  customer_notes: z.array(z.object({ text, source: span })).max(10),
+  follow_ups: z.array(z.object({ text, source: span })).max(10),
