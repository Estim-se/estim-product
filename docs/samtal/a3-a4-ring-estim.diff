+// estim Samtal A3/A4 (Ring estim): internal drafts prepared from a validated voice note, and the customer match.
+// Drafts are Samtal-owned rows (samtal_ring_drafts). Nothing here sends a quotation, an SMS or an email, places an
+// order or sets a price: quotation and material drafts always wait for a person. Browser-safe and pure.
+import type { CustomerCandidate } from '../customer-match';
+import type { Transcript } from '../transcript';
+import type { VoiceNote } from './voice-note';
+
+export type RingDraft = { kind: 'uppgift' | 'paminnelse' | 'materialunderlag' | 'offertutkast' | 'kundanteckning'; title: string; body: Record<string, unknown>; due_at: string | null; needs_review: boolean };
+export type RingCustomerMatch =
+  | { kind: 'befintlig'; customer_id: string; by: 'namn_och_adress' }
+  | { kind: 'saknas'; name: string | null; address: string | null; possible: string[] };
+
+const plain = (s: string | null | undefined) => (s ?? '').toLocaleLowerCase('sv').replace(/[^\p{L}\d]+/gu, ' ').trim();
+const cut = (s: string, n = 200) => s.length > n ? `${s.slice(0, n - 1)}…` : s;
+
+// Name and address together match one customer. A name alone, or several matches, is never a match: the candidates
+// are listed for the employee ("Kund saknas"). The caller number is the employee's, so it is never used here.
+export function matchRingCustomer(note: VoiceNote, candidates: CustomerCandidate[]): RingCustomerMatch {
+  const name = plain(note.customer.name), address = plain(note.customer.address);
+  const both = name && address ? candidates.filter(c => plain(c.name) === name && plain(c.address) === address) : [];
+  if (both.length === 1) return { kind: 'befintlig', customer_id: both[0]!.id, by: 'namn_och_adress' };
+  const possible = [...both, ...(name ? candidates.filter(c => plain(c.name) === name) : []), ...(address ? candidates.filter(c => plain(c.address) === address) : [])].map(c => c.id);
+  return { kind: 'saknas', name: note.customer.name, address: note.customer.address, possible: [...new Set(possible)].slice(0, 10) };
+}
+
+export function buildRingDrafts(note: VoiceNote): RingDraft[] {
+  const customer = [note.customer.name, [note.customer.address, note.customer.place].filter(Boolean).join(', ')].filter(Boolean).join(', ') || null;
+  const drafts: RingDraft[] = [];
+  const seen = new Set<string>();
+  const add = (d: RingDraft) => { const key = `${d.kind}:${d.title}`; if (!seen.has(key)) { seen.add(key); drafts.push(d); } };
+  if (note.quote.needed) {
+    add({ kind: 'uppgift', title: cut(`Ta fram offert${note.customer.name ? ` till ${note.customer.name}` : ''}`), body: { source: 'offert' }, due_at: note.quote.due?.due_at ?? null, needs_review: true });
+    add({ kind: 'offertutkast', title: cut(`Offertutkast${note.customer.name ? `: ${note.customer.name}` : ''}`), due_at: note.quote.due?.due_at ?? null, needs_review: true,
+      body: { customer, work: note.work, rows: note.materials.map(m => ({ item: m.item, quantity: m.quantity, unit: m.unit, price: null })), agreements: note.agreements,
+        status: 'Väntar på granskning', note: 'Priser och villkor sätts av en person i offertverktyget. Inget skickas automatiskt.' } });
+  }
+  for (const t of note.tasks) add({ kind: 'uppgift', title: cut(t.title), body: {}, due_at: t.due?.due_at ?? null, needs_review: true });
+  for (const r of note.reminders) add({ kind: 'paminnelse', title: cut(r.title), body: {}, due_at: r.due?.due_at ?? null, needs_review: true });
+  if (note.materials.length) add({ kind: 'materialunderlag', title: cut(`Materialunderlag${note.customer.name ? `: ${note.customer.name}` : ''}`), due_at: null, needs_review: true,
+    body: { customer, items: note.materials, ordered: false, note: 'Underlag för beställning. Ingen beställning görs utan godkännande.' } });
+  const noteBody = { customer, project: note.project, work: note.work, agreements: note.agreements, measurements: note.measurements, notes: note.customer_notes, follow_ups: note.follow_ups, uncertain: note.uncertain };
+  if (customer || note.work.length || note.agreements.length || note.customer_notes.length || note.follow_ups.length || note.measurements.length)
+    add({ kind: 'kundanteckning', title: cut(`Anteckning${note.customer.name ? `: ${note.customer.name}` : ''}`), body: noteBody, due_at: null, needs_review: note.uncertain.length > 0 });
+  return drafts.slice(0, 30);
+}
+
+// A mixed note keeps only the business passages: every segment overlapping a private span is removed.
+export function redactTranscript(t: Transcript, spans: { start: number; end: number }[]): Transcript {
+  if (!spans.length) return t;
+  return { ...t, segments: t.segments.filter(s => !spans.some(p => p.start < s.end && s.start < p.end)) };
+}
diff -ruN ra/src/lib/samtal/ring/ingest.server.ts rb/src/lib/samtal/ring/ingest.server.ts
--- ra/src/lib/samtal/ring/ingest.server.ts	1970-01-01 00:00:00.000000000 +0000
+++ rb/src/lib/samtal/ring/ingest.server.ts	2026-11-26 14:15:43.394349364 +0000
@@ -0,0 +1,61 @@
+// estim Samtal A3/A4 (Ring estim): receiving one voice note on the shared Ring estim number. The company and the
+// employee are resolved in the database (samtal_ring_ingest) from the authenticated provider account only; the
+// destination number, the caller number and the content are never used for identity. Audio follows the existing
+// reserve -> upload -> confirm path; a validated provider transcript means no speech to text is needed.
+// Logging: structural codes only.
+import type { SupabaseClient } from '@supabase/supabase-js';
+import type { Database, Json } from '@/integrations/supabase/types';
+import type { SamtalAudio } from '../adapter';
+import { samtalEnabled } from '../flag';
+import { validateProviderTranscript } from '../provider-transcript';
+
+type Db = SupabaseClient<Database>;
+export type RingNote = {
+  provider: string; provider_call_id: string;
+  // From the provider's authenticated account (A7 identity), never from caller ID.
+  account_ref: string; account_verified: boolean;
+  started_at: string; ended_at: string | null; duration_seconds: number | null;
+  transcript?: unknown;
+  audio?: { extension: string; open: () => Promise<SamtalAudio> } | null;
+};
+export type RingIngestResult =
+  | { status: 'disabled' | 'duplicate' | 'retry' | 'backpressure' }
+  | { status: 'rejected'; reason: string }
+  | { status: 'pending_company'; pendingId: string }
+  | { status: 'registered'; callId: string; companyId: string }
+  | { status: 'cleanup_pending'; callId: string; companyId: string }
+  | { status: 'failed'; stage: 'register' | 'audio' | 'upload'; code: string; callId?: string };
+
+const code = (e: unknown) => { const m = (e as { message?: unknown } | null)?.message; return typeof m === 'string' && /^[a-z_]{1,60}$/.test(m) ? m : 'audio_unavailable'; };
+
+export async function ingestRingNote(db: Db, note: RingNote, requestId: string = crypto.randomUUID()): Promise<RingIngestResult> {
+  if (!samtalEnabled()) return { status: 'disabled' };
+  const checked = note.transcript === undefined || note.transcript === null ? null
+    : validateProviderTranscript(note.transcript, { provider: note.provider, provider_call_id: note.provider_call_id, duration_seconds: note.duration_seconds });
+  const transcript = checked?.ok ? checked.transcript : null;
+  // An invalid provider transcript is never trusted; with audio the note falls back to speech to text.
+  if (!transcript && !note.audio) return { status: 'rejected', reason: checked && !checked.ok ? checked.code : 'no_content' };
+  const payload = { provider: note.provider, provider_call_id: note.provider_call_id, account_ref: note.account_ref, started_at: note.started_at, ended_at: note.ended_at, duration_seconds: note.duration_seconds };
+  const reg = await db.rpc('samtal_ring_ingest', { payload, p_account_verified: note.account_verified === true, p_transcript: transcript as unknown as Json,
+    p_request: requestId, p_extension: note.audio && !transcript ? note.audio.extension : (null as unknown as string) });
+  if (reg.error) return { status: 'failed', stage: 'register', code: 'register_failed' };
+  const r = (reg.data ?? {}) as { status?: string; reason?: string; pending_id?: string; call_id?: string; company_id?: string; audio?: { id: string; audio_path?: string; upload_token?: string; state: string } };
+  if (r.status === 'rejected') return { status: 'rejected', reason: typeof r.reason === 'string' && /^[a-z_]{1,60}$/.test(r.reason) ? r.reason : 'rejected' };
+  if (r.status === 'pending_company' && r.pending_id) return { status: 'pending_company', pendingId: r.pending_id };
+  if (r.status === 'retry' || r.status === 'backpressure' || r.status === 'duplicate') return { status: r.status };
+  if (!r.call_id || !r.company_id) return { status: 'failed', stage: 'register', code: 'register_invalid_response' };
+  if (r.status === 'attached') return { status: 'registered', callId: r.call_id, companyId: r.company_id };
+  if (r.status !== 'upload' || !r.audio?.upload_token || !r.audio.audio_path || !note.audio) return { status: 'duplicate' };
+  const callId = r.call_id, companyId = r.company_id, audio = r.audio as { id: string; audio_path: string; upload_token: string };
+  if (!audio.audio_path.startsWith(`${companyId}/`)) return { status: 'failed', stage: 'register', code: 'audio_path_invalid', callId };
+  let uploaded = false, failure: { stage: 'audio' | 'upload'; code: string } | null = null;
+  try {
+    const bytes = await note.audio.open();
+    const up = await db.storage.from('samtal-audio').upload(audio.audio_path, bytes.bytes, { contentType: bytes.contentType, upsert: false });
+    if (up.error) failure = { stage: 'upload', code: 'audio_upload_failed' }; else uploaded = true;
+  } catch (e) { failure = { stage: 'audio', code: code(e) }; }
+  const done = await db.rpc('samtal_finish_audio', { p_call: callId, p_company: companyId, p_audio: audio.id, p_token: audio.upload_token, p_uploaded: uploaded });
+  if (failure) return { status: 'failed', ...failure, callId };
+  if (done.error || done.data !== true) return { status: 'cleanup_pending', callId, companyId };
+  return { status: 'registered', callId, companyId };
+}
