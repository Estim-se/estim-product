{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *--admin*)",
      "Bash(gh pr review *--approve*)",
      "Bash(gh pr review *-a)",
      "Bash(gh pr review *-a *)",
      "Bash(git push *--force*)",
      "Bash(git push *-f)",
      "Bash(git push *-f *)",
      "Bash(git push *+*)",
      "Bash(git push *--no-verify*)",
      "Bash(gh workflow run *)",
      "PowerShell(gh pr merge *--admin*)",
      "PowerShell(gh pr review *--approve*)",
      "PowerShell(gh pr review *-a)",
      "PowerShell(gh pr review *-a *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push *-f)",
      "PowerShell(git push *-f *)",
      "PowerShell(git push *+*)",
      "PowerShell(git push *--no-verify*)",
      "PowerShell(gh workflow run *)",
      "mcp__lovable__respond_to_approval",
      "mcp__lovable__deploy_project",
      "mcp__lovable__accept_draft",
      "mcp__lovable__query_database",
      "mcp__lovable__set_project_visibility",
      "mcp__lovable__set_project_knowledge",
      "mcp__lovable__set_workspace_knowledge"
    ]
  }
}
