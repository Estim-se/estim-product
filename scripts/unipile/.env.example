# Copy to .env (same folder) and fill in. .env is git-ignored.
# API key from your own Unipile trial account (dashboard -> API keys).
UNIPILE_API_KEY=
# Optional: only if Unipile gives you another API address.
# UNIPILE_API_URL=https://api.unipile.com/v2
# Filled in after step 3 in README (the secret Unipile returns when the webhook is created).
UNIPILE_WEBHOOK_SECRET=
